diff --git a/src/main/java/net/minecraft/server/PacketPlayOutExhaustion.java b/src/main/java/net/minecraft/server/PacketPlayOutExhaustion.java
new file mode 100644
index 000000000..5741cb90c
--- /dev/null
+++ b/src/main/java/net/minecraft/server/PacketPlayOutExhaustion.java
@@ -0,0 +1,17 @@
+package net.minecraft.server;
+
+// Server-side in your Paper fork
+import io.netty.buffer.Unpooled;
+
+public class PacketPlayOutExhaustion extends PacketPlayOutCustomPayload {
+
+    public PacketPlayOutExhaustion(float exhaustion) {
+        super("MC|Exhaustion", serializeData(exhaustion));
+    }
+
+    private static PacketDataSerializer serializeData(float exhaustion) {
+        PacketDataSerializer serializer = new PacketDataSerializer(Unpooled.buffer());
+        serializer.writeFloat(exhaustion);
+        return serializer;
+    }
+}
diff --git a/src/main/java/net/minecraft/server/PacketPlayOutUpdateHealth.java b/src/main/java/net/minecraft/server/PacketPlayOutUpdateHealth.java
