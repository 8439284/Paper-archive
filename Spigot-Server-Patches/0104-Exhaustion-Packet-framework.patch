@@ -0,0 +1,70 @@
+package net.minecraft.server;
+
+import java.io.IOException;
+
+public class PacketPlayOutUpdateHealth implements Packet<PacketListenerPlayOut> {
+    private float a;
+    private int b;
+    private float c;
+    // Add new field for exhaustion
+    private float exhaustion;
+
+    public PacketPlayOutUpdateHealth() {
+    }
+
+    // Original constructor
+    public PacketPlayOutUpdateHealth(float health, int food, float saturation) {
+        this.a = health;
+        this.b = food;
+        this.c = saturation;
+        this.exhaustion = 0.0F; // Default value
+    }
+
+    // New constructor with exhaustion
+    public PacketPlayOutUpdateHealth(float health, int food, float saturation, float exhaustion) {
+        this.a = health;
+        this.b = food;
+        this.c = saturation;
+        this.exhaustion = exhaustion;
+    }
+
+    @Override
+    public void a(PacketDataSerializer serializer) throws IOException {
+        this.a = serializer.readFloat();
+        this.b = serializer.e();
+        this.c = serializer.readFloat();
+        // Add exhaustion to the packet
+        this.exhaustion = serializer.readFloat();
+    }
+
+    @Override
+    public void b(PacketDataSerializer serializer) throws IOException {
+        serializer.writeFloat(this.a);
+        serializer.b(this.b);
+        serializer.writeFloat(this.c);
+        // Write exhaustion to the packet
+        serializer.writeFloat(this.exhaustion);
+    }
+
+    @Override
+    public void a(PacketListenerPlayOut packetlistenerplayout) {
+        packetlistenerplayout.a(this);
+    }
+
+    // Getters for all fields
+    public float getHealth() {
+        return this.a;
+    }
+
+    public int getFoodLevel() {
+        return this.b;
+    }
+
+    public float getSaturationLevel() {
+        return this.c;
+    }
+
+    public float getExhaustionLevel() {
+        return this.exhaustion;
+    }
+}
